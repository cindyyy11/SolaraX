# Base URL for the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Base URL for the M5 vision API (no trailing slash).
#
# 127.0.0.1 only resolves when the API runs on the SAME machine as the browser.
# Frontend code executes in the visitor's browser, so a deployed build pointing
# here asks the visitor's own machine for port 8000 and gets nothing. Set this
# to the hosted API for any deployed environment, and note that a page served
# over HTTPS cannot call an HTTP endpoint — the hosted URL must be HTTPS.
#
#   local:    uvicorn pipeline.vision_api:app --reload   (from the repo root)
#   deployed: https://<space-name>.hf.space
VITE_VISION_API_URL=http://127.0.0.1:8000
